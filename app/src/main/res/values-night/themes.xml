<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Dark-mode variant of the Activity theme (auto-applied by Android
        when the device is in dark mode via values-night/ qualifier).
        Compose handles actual UI colors; this just covers the cold-start
        window background so there's no white flash on dark-mode launch.
    -->
    <style name="Theme.FinalProject" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF0A0A0F</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
