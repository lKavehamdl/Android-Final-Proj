<?xml version="1.0" encoding="utf-8"?>
<!--
    Melodify Adaptive Icon — Background Layer
    Deep purple radial gradient: center #6C63FF → edges #1A0080
    This fills the full 108×108dp adaptive icon canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Full-canvas background rectangle with radial gradient -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:gradientRadius="76"
                android:centerX="54"
                android:centerY="54"
                android:startColor="#7C73FF"
                android:endColor="#1A0080" />
        </aapt:attr>
    </path>

    <!-- Subtle inner glow ring (soft translucent circle at center) -->
    <path android:pathData="M54,18 A36,36 0 1,1 53.999,18 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:gradientRadius="36"
                android:centerX="54"
                android:centerY="54"
                android:startColor="#30FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>

</vector>
