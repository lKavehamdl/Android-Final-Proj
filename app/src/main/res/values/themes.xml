<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Activity-level theme (View layer).
        Compose handles colors and dark/light via MaterialTheme.
        This theme just controls:
          • Window background (shown briefly during cold start)
          • Status bar / nav bar transparency for edge-to-edge
          • No action bar (Compose handles its own top bars)
    -->
    <style name="Theme.FinalProject" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFF5F3FF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>